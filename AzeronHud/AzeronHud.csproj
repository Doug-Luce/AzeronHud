<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <AssemblyName>AzeronHud</AssemblyName>
    <Version>1.1.0.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Description>Draws your Azeron keypad over FFXIV, labelled with what each button does.</Description>
    <Authors>aurelius</Authors>
    <PackageProjectUrl>https://github.com/Doug-Luce/AzeronHud</PackageProjectUrl>

    <!-- Lets the plugin build on a machine without the Windows Desktop runtime,
         which includes Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- The JSON models are populated by reflection, which the compiler can't see. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Device layouts are embedded, so the plugin needs nothing on disk to draw a keypad. -->
  <ItemGroup>
    <EmbeddedResource Include="Layout/*.json" />
  </ItemGroup>

</Project>
